# Copy this file to .env (same folder) and fill in your values.
# .env is git-ignored - never commit real credentials.

# ---- Snowflake (required: used by mcp_servers/snowflake_mcp.py) ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CUSTOM_AGENT
SNOWFLAKE_SCHEMA=STAGING

# ---- Jira (optional: only needed for mcp_servers/jira_mcp.py / jira-ticket-agent) ----
# JIRA_DOMAIN=https://your-company.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
